build esp-idf/esp_hw_support/port/esp32s3/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/esp_hw_support/port/esp32s3/all
  COMMAND = cmd.exe /C "cd /D D:\esp32_code\pthread\build\esp-idf\esp_hw_support\port\esp32s3 && D:\Espressif\tools\cmake\3.24.0\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

