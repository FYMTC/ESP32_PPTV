#############################################
# Utility command for edit_cache

build esp-idf/unity/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\esp32_code\pthread\build\esp-idf\unity && D:\Espressif\tools\cmake\3.24.0\bin\cmake-gui.exe -SD:\esp32_code\pthread -BD:\esp32_code\pthread\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/unity/edit_cache: phony esp-idf/unity/CMakeFiles/edit_cache.util


