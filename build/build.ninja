build esp-idf/freertos/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\esp32_code\pthread\build\esp-idf\freertos && D:\Espressif\tools\cmake\3.24.0\bin\cmake-gui.exe -SD:\esp32_code\pthread -BD:\esp32_code\pthread\build"
