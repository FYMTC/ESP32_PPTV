build esp-idf/thread_manager/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\esp32_code\pthread\build\esp-idf\thread_manager && D:\Espressif\tools\cmake\3.24.0\bin\cmake-gui.exe -SD:\esp32_code\pthread -BD:\esp32_code\pthread\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/thread_manager/edit_cache: phony esp-idf/thread_manager/CMakeFiles/edit_cache.util


#############################################
